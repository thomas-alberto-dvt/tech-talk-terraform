# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files with sensitive data
# (Keep terraform.tfvars if you want to version them for demos)
# *.tfvars
# *.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan
*.tfplan.*
tfplan.binary
plan.json

# Ignore lock file (optional - some prefer to version it)
# .terraform.lock.hcl

# Infracost files
infracost.json
infracost-*.json
*.html
.infracost/

# Temporary files
*.md
!README.md
!GUION_INFRACOST.md
*.json
!package*.json
!tsconfig*.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Credentials
credentials.json
*.key
*.pem
service-account*.json
